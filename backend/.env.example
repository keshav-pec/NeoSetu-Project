PORT=8080
# MongoDB Atlas connection string
MONGO_URI=
JWT_SECRET=
# Frontend URL on Vercel (leave blank to allow any origin during development)
CLIENT_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# AI Service URL on Render (defaults to http://localhost:5001)
AI_SERVICE_URL=
# Shared secret between the backend and the AI Service (must match ai-service/.env)
AI_SERVICE_KEY=
